# Remy configuration. Copy to .env (docker compose and local runs read it) or set the same variables in
# the Portainer stack UI. Every variable is optional: an empty or missing value takes the default shown here.

# Database (SQLAlchemy URL). Default: a SQLite file in the /data volume of the container.
# Postgres works too, e.g. postgresql+psycopg://remy:password@db:5432/remy
DATABASE_URL=sqlite:////data/remy.db

# Bearer key with admin rights: creating users and their API keys. Generate a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable admin access over HTTP.
REMY_ADMIN_KEY=

# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Host port the service is published on by docker-compose.yml (the container listens on 8000).
REMY_PORT=18100
