# Remy configuration. Copy to .env (docker compose and local runs read it) or set the same variables in
# the Portainer stack UI. An empty or missing value takes the default shown here.

# Bearer key every /v1 call must send (Authorization: Bearer <key>). Required: unset, /v1 refuses every call.
# Generate a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REMY_API_KEY=

# Anthropic API key for recipe suggestions (POST /v1/suggest). Unset: that route answers 503; the rest works.
# The pantry, meal, servings, target and notes of each request are sent to Anthropic; nothing else.
ANTHROPIC_API_KEY=
# Claude model that drafts the recipes.
REMY_MODEL=claude-opus-5-5

# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Host port the service is published on by docker-compose.yml (the container listens on 8000).
REMY_PORT=18100
